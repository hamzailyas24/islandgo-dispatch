# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# Signs the demo session cookie — use any long random string
SESSION_SECRET=change-this-to-a-long-random-string

# Demo Admin account
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=change-me

# Demo Driver account — maps to the seeded "John Driver" row so the
# scripted demo flow (booking -> assign John Driver -> accept -> ... )
# works end to end. Copy John Driver's id from the drivers table after
# running supabase/schema.sql and paste it below.
DEMO_DRIVER_USERNAME=driver
DEMO_DRIVER_PASSWORD=change-me
DEMO_DRIVER_ID=paste-johns-driver-row-id-here
DEMO_DRIVER_NAME=John Driver
